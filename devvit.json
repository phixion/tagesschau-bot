{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "tagesschau-bot",
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "triggers": {
    "onAppInstall": "/internal/on-app-install",
    "onAppUpgrade": "/internal/on-app-upgrade"
  },
  "scheduler": {
    "tasks": {
      "poll-rss-feed": {
        "endpoint": "/internal/scheduler/poll-rss-feed"
      }
    }
  },
  "settings": {
    "subreddit": {
      "feedUrls": {
        "type": "paragraph",
        "label": "Feed URLs",
        "helpText": "One or more Tagesschau RSS feed URLs to monitor (one per line or comma-separated)"
      },
      "targetSubreddit": {
        "type": "string",
        "label": "Target subreddit"
      },
      "pollMinutes": {
        "type": "number",
        "label": "Poll interval (minutes)"
      },
      "maxPostsPerRun": {
        "type": "number",
        "label": "Max posts per run"
      },
      "maxDedupeTrack": {
        "type": "number",
        "label": "Remember this many post fingerprints"
      },
      "postKind": {
        "type": "string",
        "label": "Post kind: self or link"
      },
      "maxBodyChars": {
        "type": "number",
        "label": "Maximum body length for self-post"
      }
    }
  },
  "permissions": {
    "http": {
      "enable": true,
      "domains": [
        "www.tagesschau.de",
        "storage.googleapis.com"
      ]
    },
    "redis": true,
    "reddit": true
  },
  "scripts": {
    "dev": "node tools/build.mjs --watch",
    "build": "node tools/build.mjs"
  },
  "marketingAssets": {
    "icon": "assets/icon.png"
  },
  "dev": {
    "subreddit": "phixion_test_dev"
  }
}