# Core feed settings
FEED_URL=./fixtures/sample-rss.xml
TARGET_SUBREDDIT=YourSubreddit
POLL_MINUTES=15
MAX_POSTS_PER_RUN=3
POST_KIND=self
TITLE_PREFIX=[Episode] 
MAX_BODY_CHARS=12000

# Local harness behavior
STATE_FILE=.local-state.json
MAX_DEDUPE_TRACK=500
DRY_RUN=true

# Local live-submit auth source (used by "npm run local:live")
# Run "npx devvit login" first so ~/.devvit/token exists.
DEVVIT_TOKEN_FILE=~/.devvit/token
# Optional, defaults to "devvit-rss-to-post-bot/0.1"
REDDIT_USER_AGENT=tagesschau-bot/0.1 by u/pheexio
